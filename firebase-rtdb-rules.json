{
  "rules": {
    "players": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$message": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid && newData.child('text').val().length <= 160"
      }
    },
    "worldEdits": {
      ".read": "auth != null",
      "$edit": {
        ".write": "auth != null && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['x','y','id','uid']) && newData.child('id').val() in ['air','grass','dirt','stone','deepslate','sand','snow','ice','wood','leaf','cactus','clay','brick','glass','coal','iron','gold','diamond','emerald','water','lava','torch','glowstone','obsidian']"
      }
    }
  }
}
